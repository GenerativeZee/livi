# Copy to .env.local and fill in. Each spike only needs its own section.

# --- Spike 1 & 2: AWS IVS (live video + product pins) ---
# Credentials for an IAM user with ivs:CreateChannel and ivs:PutMetadata.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Filled from the output of `npm run spike:ivs-channel`:
IVS_CHANNEL_ARN=
IVS_INGEST_ENDPOINT=
IVS_STREAM_KEY=
IVS_PLAYBACK_URL=

# Shared secret the creator types on /spike/live (min 8 chars). Guards the stream key and pin API.
SPIKE_CREATOR_TOKEN=

# --- Spike 3: Razorpay (test mode keys from dashboard.razorpay.com) ---
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
# Optional Razorpay Route linked accounts (acc_...). Leave empty to test checkout without splits.
RAZORPAY_SELLER_ACCOUNT_ID=
RAZORPAY_CREATOR_ACCOUNT_ID=
