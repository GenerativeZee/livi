# Copy to .env.local. Everything is optional: with no file at all the app runs on fake providers
# and an in-memory database seeded with demo data.

# --- Provider selection (all default to "fake") ---
VIDEO_PROVIDER=local       # local (dev default: browser-to-browser video) | fake (no video) | ivs
PAYMENT_PROVIDER=fake      # fake | razorpay
# OTP_PROVIDER and SHIPPING_PROVIDER only have "fake" for now.

# --- Database ---
# Leave unset for the in-memory database (resets on every restart).
# DATABASE_URL=postgres://stealth:stealth@localhost:5432/stealth

# --- AWS IVS (needed when VIDEO_PROVIDER=ivs) ---
# Credentials for an IAM user with ivs:CreateChannel and ivs:PutMetadata.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Filled from the output of `npm run spike:ivs-channel`:
IVS_CHANNEL_ARN=
IVS_INGEST_ENDPOINT=
IVS_STREAM_KEY=
IVS_PLAYBACK_URL=

# --- Razorpay (needed when PAYMENT_PROVIDER=razorpay; test keys from dashboard.razorpay.com) ---
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
# Optional Route linked accounts (acc_...) given to the demo seller and creator when the dev database is seeded.
# Leave empty to test checkout without splits.
RAZORPAY_SELLER_ACCOUNT_ID=
RAZORPAY_CREATOR_ACCOUNT_ID=
